# HeySure Workspace (lightweight meta-repo)
# The three main components are Git *submodules*:
#   - HeySure-Web     → deploy/web/
#   - HeySure-Server  → deploy/server/
#   - HeySure-Device  → device/
#
# They are linked via .gitmodules. Content lives in the separate repos.
# Server deploy: git submodule update --init --recursive -- deploy/server deploy/web

# Environment
.env
.env.*
!.env.example

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Build / temp artifacts that may leak at workspace level
node_modules/
dist/
*.log
*.tmp

# Compose deployment state generated by docker-run.sh / write_deploy_version.py
server/data/deployed-version.json

# Python (in case anything runs at root)
__pycache__/
*.pyc
.venv/
venv/
