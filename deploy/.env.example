# HeySure AI 2.0 - Workspace Environment
# Copy this file to .env (in the workspace root) and fill in values.
# This .env is read by server/ (all four runtimes) and some launchers.

# =============================================================================
# REQUIRED
# =============================================================================

# PostgreSQL connection (required, only Postgres supported)
DATABASE_URL=postgresql+psycopg://heysure:heysure@127.0.0.1:5432/heysure

# Internal token used for /internal/* calls between gateway and the other three runtimes.
# Must be the same value in all four server processes.
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEYSURE_INTERNAL_TOKEN=

# =============================================================================
# RUNTIME URLS (when running split processes)
# =============================================================================

MCP_RUNTIME_URL=http://127.0.0.1:3001
CONNECTOR_RUNTIME_URL=http://127.0.0.1:3002
AI_RUNTIME_URL=http://127.0.0.1:3003
# Gateway-side health probe for the Web console. Docker Compose overrides this
# with http://web:58150; leave empty for standalone local development.
HEYSURE_WEB_RUNTIME_URL=

# Use "remote" to have gateway dispatch chat work to ai-runtime (recommended for full setup)
AI_DISPATCH_MODE=remote

# Base URL used by web console and device clients to reach the API
SERVER_URL=http://127.0.0.1:3000

# Docker deployments: the gateway container talks to this host-side updater to
# check/pull/rebuild without requiring /app inside the container to be a Git repo.
HEYSURE_REPO_UPDATER_URL=http://host.docker.internal:58151
# Defaults to HEYSURE_INTERNAL_TOKEN when empty.
HEYSURE_REPO_UPDATER_TOKEN=

# Independent host recovery plane (systemd, default port 58152). This secret is
# entered only in the unauthenticated homepage recovery dialog and must be
# different from JWT_SECRET / HEYSURE_INTERNAL_TOKEN / updater credentials.
HEYSURE_RESCUE_TOKEN=
# Optional comma-separated browser origins when the console and rescue service
# use different hostnames. Same-host origins are accepted automatically.
HEYSURE_RESCUE_ALLOWED_ORIGINS=
HEYSURE_RESCUE_AUTO_RECOVER=true

# Optional Docker image-build proxy. Runtime containers deliberately do not
# inherit these values; bot platforms and application APIs connect directly.
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_ALL_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,::1,db,api-gateway,ai-runtime,mcp-runtime,connector-runtime,web,host.docker.internal,ilinkai.weixin.qq.com,novac2c.cdn.weixin.qq.com,.weixin.qq.com,.qq.com

# Working directory for desktop/Android agents (where they store local files)
WORKSPACE_ROOT=

# =============================================================================
# AUTH
# =============================================================================

# Required. Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Encrypts WeChat/iLink bot tokens and conversation context tokens at rest.
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this stable; changing it requires every bot connection to scan again.
HEYSURE_BOT_ENCRYPTION_SECRET=

# Static agent token (used by desktop/browser/mobile agents when connecting via Socket.IO)
AGENT_TOKEN=

# =============================================================================
# THIRD PARTY
# =============================================================================

# Tavily web search (used by workspace.search tool)
TAVILY_API_KEY=

# ClawHub (skill registry)
CLAWHUB_REGISTRY_URL=https://clawhub.ai
CLAWHUB_API_TOKEN=

# Huawei Push Kit (optional Android background notification fallback).
# The client secret belongs only on the server and must never be packaged into the APK.
HEYSURE_HUAWEI_PUSH_CLIENT_ID=
HEYSURE_HUAWEI_PUSH_CLIENT_SECRET=

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_JSON=false

# =============================================================================
# OPTIONAL / ADVANCED
# =============================================================================

# HEYSURE_DB_AUTO_MIGRATE=0          # set to 0 when using the separate db-migrate service in Docker

# Task schedule wall-clock timezone (IANA name). Keep this explicit in Docker,
# whose system timezone is commonly UTC. Empty means server-local timezone.
HEYSURE_TIMEZONE=Asia/Shanghai

# Public URLs (for link generation etc.)
# Public Gateway/Web base that serves /api/*, for example
# http://127.0.0.1:3000 or https://console.example.com. Do not point this at
# a connector-only port unless that endpoint also proxies /api/tmp-files/*.
# HEYSURE_PUBLIC_BASE_URL=
# HEYSURE_AGENT_SOCKET_URL=http://127.0.0.1:3002
